# Public canonical URL, without a trailing slash
NEXT_PUBLIC_SITE_URL=https://getsocialcurrent.com
GOOGLE_SITE_VERIFICATION=

# Provider credentials. API keys remain server-only.
SMM_FOLLOWIZ_API_URL=https://followiz.com/api/v2
SMM_FOLLOWIZ_API_KEY=
SMM_SMMWORLD_API_URL=https://smmworldpanel.com/api/v2
SMM_SMMWORLD_API_KEY=
SMM_SMMPWR_API_URL=https://smmpwr.com/api/v2
SMM_SMMPWR_API_KEY=

# Use at least 32 random characters for each secret.
ORDER_TOKEN_SECRET=
SMM_ADMIN_TOKEN=
SMM_FULFILLMENT_SECRET=

# Keep false until payment confirmation calls the order API with
# x-social-current-fulfillment: SMM_FULFILLMENT_SECRET.
SMM_LIVE_ORDERING=false
SMM_ALLOW_UNPAID_ORDERS=false

# Route format: provider:serviceId. Add comma-separated fallbacks only when desired.
# Examples: smmworld:12345 or followiz:8301,smmpwr:402
SMM_ROUTE_INSTAGRAM_FOLLOWERS_STANDARD=
SMM_ROUTE_INSTAGRAM_FOLLOWERS_PREMIUM=
SMM_ROUTE_INSTAGRAM_FOLLOWERS_USA_FEMALE=
SMM_ROUTE_INSTAGRAM_FOLLOWERS_USA_MALE=
SMM_ROUTE_INSTAGRAM_FOLLOWERS_EUROPE=
SMM_ROUTE_INSTAGRAM_LIKES_STANDARD=
SMM_ROUTE_INSTAGRAM_LIKES_PREMIUM=
SMM_ROUTE_INSTAGRAM_LIKES_USA_EUROPE=
SMM_ROUTE_INSTAGRAM_VIEWS_STANDARD=
SMM_ROUTE_INSTAGRAM_COMMENTS_STANDARD_COMMENTS=
SMM_ROUTE_INSTAGRAM_COMMENTS_CUSTOM_COMMENTS=
SMM_ROUTE_INSTAGRAM_COMMENTS_USA_COMMENTS=

SMM_ROUTE_TIKTOK_FOLLOWERS_STANDARD=
SMM_ROUTE_TIKTOK_FOLLOWERS_PREMIUM=
SMM_ROUTE_TIKTOK_LIKES_STANDARD=
SMM_ROUTE_TIKTOK_LIKES_PREMIUM=
SMM_ROUTE_TIKTOK_VIEWS_STANDARD=
SMM_ROUTE_TIKTOK_COMMENTS_STANDARD_COMMENTS=
SMM_ROUTE_TIKTOK_COMMENTS_CUSTOM_COMMENTS=

SMM_ROUTE_YOUTUBE_SUBSCRIBERS_STANDARD=
SMM_ROUTE_YOUTUBE_SUBSCRIBERS_PREMIUM=
SMM_ROUTE_YOUTUBE_LIKES_STANDARD=
SMM_ROUTE_YOUTUBE_LIKES_PREMIUM=
SMM_ROUTE_YOUTUBE_LIKES_USA=
